{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "floorconcepts-web",
  "compatibility_date": "2026-04-19",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Must match the worker "name" above — avoids Cloudflare error 10143
      "service": "floorconcepts-web",
    },
  ],
  "r2_buckets": [],
  "images": {
    "binding": "IMAGES",
  },
}
